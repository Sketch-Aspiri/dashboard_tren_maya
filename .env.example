APP_NAME="Dashboard - Zona Oriente"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 en todos los entornos (local, pruebas y producción), siempre en
# 127.0.0.1 — ver .claude/rules/server-conventions.md. Nunca apuntes DB_HOST
# a una dirección pública. Las pruebas (phpunit.xml) usan la base
# DB_DATABASE=dashboard_jefe_zona_test con este mismo usuario: créala vacía
# y dale permisos al usuario antes de correr `php artisan test`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard_jefe_zona
DB_USERNAME=dashboard_app
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production/staging sit behind Tailscale VPN + Let's Encrypt TLS (see
# .claude/rules/server-conventions.md) — the session cookie MUST be marked
# secure there. Only leave this false for plain-HTTP local development.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Two-factor authentication (pragmarx/google2fa-laravel). Por defecto
# encendido. Decisión del Jefe de Zona (oct 2026): en el .env del VPS se pone
# TWO_FACTOR_ENABLED=false mientras todo el equipo comparte una sola cuenta;
# volver a true en cuanto existan cuentas individuales. Un valor vacío o
# inválido cuenta como true.
TWO_FACTOR_ENABLED=true
OTP_ENABLED=true
OTP_LIFETIME=0
OTP_KEEP_ALIVE=true
OTP_THROW_EXCEPTION=true

# Oficios de asistencia (.docx -> .pdf): ruta del ejecutable de LibreOffice.
# Windows: C:\Program Files\LibreOffice\program\soffice.exe — VPS Ubuntu: soffice
# (apt install libreoffice-writer fonts-noto). Ver config/asistencia_documentos.php.
ASISTENCIA_SOFFICE_PATH=soffice

# Secciones (tablas dinámicas y documentos): tamaño máximo por archivo en KB.
# 102400 = 100 MB. En el VPS hay que subir también upload_max_filesize /
# post_max_size (PHP-FPM) y client_max_body_size (Nginx) — ver
# docs/despliegue-produccion.md.
SECCIONES_MAX_ARCHIVO_KB=102400
# Cada cuántos minutos se revisan los documentos vinculados a la nube (1-59)
SECCIONES_SYNC_MINUTOS=15
SECCIONES_NUBE_RESERVA_DISCO_GB=10
# % máximo de filas que una sincronización puede archivar de una tabla espejo sin pedir confirmación
SECCIONES_NUBE_ESPEJO_MAX_ARCHIVADO_PCT=50

# OAuth de nubes (solo lectura) — OPCIONAL. Lo normal es que el Administrador cargue
# el Client ID / Secret desde la app (menú de usuario > Conexiones de nube); lo guardado
# ahí tiene prioridad. Estas variables son solo una alternativa. Ver docs/nube-oauth.md.
# MICROSOFT_REDIRECT_URI / GOOGLE_REDIRECT_URI / DROPBOX_REDIRECT_URI ya no se usan:
# la Redirect URI se calcula y se muestra en Conexiones de nube.
# Valores falsos: los reales van solo en el .env del servidor.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://dashboard.example.com/nube/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dashboard.example.com/nube/google/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://dashboard.example.com/nube/dropbox/callback

# IA (Claude API) — opcional. Vacío = apagada: no aparece el asistente del
# dashboard ni el botón "Extraer con IA". Los documentos y resultados de
# consultas que se envían salen del VPS hacia Anthropic; cada uso queda en la
# bitácora.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ASISTENTE_LIMITE_POR_MINUTO=10
ASISTENTE_LIMITE_DIARIO=300

# Temayin (asistente de preguntas frecuentes): enlace para reportar fallas a
# Soporte del sistema, en el sitio de Tickets.
TICKETS_SOPORTE_URL=https://tickets.zonaorientetm.tech/tickets/create

# Ecosistema Zona Oriente (Dashboard + Tickets): direccion publica de cada sistema (docs/ECOSISTEMA.md).
ECOSISTEMA_DASHBOARD_URL=https://dashboard.zonaorientetm.tech
ECOSISTEMA_TICKETS_URL=https://tickets.zonaorientetm.tech

# Inicio de sesion unico Dashboard <-> Tickets: el MISMO valor en ambos .env (32+ caracteres aleatorios).
ECOSISTEMA_SSO_SECRET=

# Puente interno Dashboard <-> Tickets: cada secreto con el MISMO valor en ambos .env (docs/ECOSISTEMA.md).
ECOSISTEMA_PUENTE_SECRETO_DASHBOARD=
ECOSISTEMA_PUENTE_SECRETO_TICKETS=
# Opcional: dirección interna de Tickets e IPs (coma) desde las que se aceptan llamadas.
ECOSISTEMA_PUENTE_TICKETS_URL=
ECOSISTEMA_PUENTE_IPS=

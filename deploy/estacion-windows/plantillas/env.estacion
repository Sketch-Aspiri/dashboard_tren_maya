APP_NAME="{{APP_NAME}}"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Cancun
APP_URL={{APP_URL}}
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT={{DB_PORT}}
DB_DATABASE=dashboard_jefe_zona
DB_USERNAME=dashboard_app
DB_PASSWORD={{DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# La estacion se usa por HTTP dentro de su red local: la cookie no puede ser "secure".
# En el servidor en la nube (HTTPS) esto va en true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No hay trabajador de colas en la estacion: los procesos corren en la misma peticion.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# Excepcion vigente (cuenta compartida por decision del Jefe de Zona, oct 2026).
TWO_FACTOR_ENABLED=false
OTP_ENABLED=true
OTP_LIFETIME=0
OTP_KEEP_ALIVE=true
OTP_THROW_EXCEPTION=true

# Comillas simples: con dobles, "\P" "\L"... se leerian como secuencias de escape.
ASISTENCIA_SOFFICE_PATH='{{SOFFICE}}'
SECCIONES_MAX_ARCHIVO_KB=102400

# IA apagada hasta contar con el visto bueno del Area de TIC.
ANTHROPIC_API_KEY=

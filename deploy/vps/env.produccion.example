# .env de PRODUCCIÓN del VPS. Copiar a <RUTA_SITIO>/.env y rellenar los <...>.
# Este archivo solo tiene placeholders: el .env real NUNCA entra a git ni se
# manda por chat/correo (créalo directo en el servidor).

APP_NAME="Dashboard - Zona Oriente"
APP_ENV=production
APP_KEY=                      # php artisan key:generate (solo la primera vez)
APP_DEBUG=false
APP_URL=https://<dominio-del-dashboard>
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard_jefe_zona
DB_USERNAME=dashboard_app
DB_PASSWORD=<contraseña-larga-aleatoria>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# OBLIGATORIO true antes de abrir el dominio al público.
TWO_FACTOR_ENABLED=true

SECCIONES_MAX_ARCHIVO_KB=102400
SECCIONES_SYNC_MINUTOS=15

# IA opcional. Vacío = apagada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Oficios de asistencia (LibreOffice instalado con apt).
ASISTENCIA_SOFFICE_PATH=/usr/bin/soffice

# --- OAuth de nubes (los entrega TI; ver docs/nube-oauth.md) ---------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://<dominio-del-dashboard>/nube/microsoft/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<dominio-del-dashboard>/nube/google/callback

DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://<dominio-del-dashboard>/nube/dropbox/callback
